# Bu dosyayı .env adıyla kopyalayıp kendi bilgilerinizi yazın.
# .env dosyası depoya gönderilmez.
DATABASE_URL=postgresql+psycopg2://postgres:SIFRE@localhost:5432/quicktick

# JWT imzalamak için uzun, rastgele bir anahtar. Üretmek için:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_GIZLI_ANAHTAR=BURAYA_RASTGELE_ANAHTAR
# Token'ın geçerlilik süresi (dakika). 10080 = 7 gün
JWT_SURE_DAKIKA=10080
